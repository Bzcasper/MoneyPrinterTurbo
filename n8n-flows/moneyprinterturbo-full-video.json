{
  "name": "MoneyPrinterTurbo — Full Video",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -760,
        140
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -760,
        320
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base_url",
              "name": "base_url",
              "type": "string",
              "value": "http://127.0.0.1:8090"
            },
            {
              "id": "body",
              "name": "body",
              "type": "object",
              "value": {
                "video_subject": "5 underrated productivity tips for busy developers",
                "video_script": "",
                "video_language": "en",
                "voice_name": "gemini:Rasalgethi-Informative",
                "video_aspect": "9:16",
                "video_concat_mode": "random",
                "video_clip_duration": 5,
                "video_count": 1,
                "video_source": "pixabay",
                "bgm_type": "random",
                "bgm_volume": 0.2
              }
            }
          ]
        },
        "options": {}
      },
      "id": "inputs",
      "name": "Workflow Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -540,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url }}/api/v1/videos",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "id": "start_video",
      "name": "Start Video Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        140
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task_id",
              "name": "task_id",
              "type": "string",
              "value": "={{ $json.data.task_id }}"
            },
            {
              "id": "video_subject",
              "name": "video_subject",
              "type": "string",
              "value": "={{ $('Workflow Inputs').item.json.body.video_subject }}"
            }
          ]
        },
        "options": {}
      },
      "id": "task_id",
      "name": "Task ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -100,
        140
      ]
    },
    {
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        120,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Workflow Inputs').item.json.base_url }}/api/v1/tasks/{{ $json.task_id }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "id": "poll",
      "name": "Poll Task Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "done",
              "leftValue": "={{ $json.data?.state }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_complete",
      "name": "If Complete",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        540,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "failed",
              "leftValue": "={{ $json.data?.state }}",
              "rightValue": -1,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if_failed",
      "name": "If Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Workflow Inputs').item.json.base_url }}/api/v1/social-metadata",
        "authentication": "none",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_subject: $json.data.video_subject, language: 'en', platform: 'tiktok' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "id": "social_metadata",
      "name": "Generate Social Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        260
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Workflow Inputs').item.json.base_url }}/api/v1/stream/{{ $json.data.videos[0].replace('/', '') }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "video"
            }
          }
        }
      },
      "id": "download_video",
      "name": "Download Final Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        260
      ]
    },
    {
      "parameters": {
        "fileName": "={{ $json.filename || 'money-printer-turbo.mp4' }}",
        "dataPropertyName": "video",
        "options": {
          "fileName": "={{ $('Task ID').item.json.task_id }}-final.mp4"
        }
      },
      "id": "write_video",
      "name": "Save Final Video",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1.1,
      "position": [
        1420,
        260
      ]
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Workflow Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Workflow Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workflow Inputs": {
      "main": [
        [
          {
            "node": "Start Video Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Video Task": {
      "main": [
        [
          {
            "node": "Task ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Task ID": {
      "main": [
        [
          {
            "node": "Wait 20s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 20s": {
      "main": [
        [
          {
            "node": "Poll Task Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Task Status": {
      "main": [
        [
          {
            "node": "If Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Complete": {
      "main": [
        [
          {
            "node": "If Failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Social Metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Failed": {
      "main": [
        [
          {
            "node": "Download Final Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Social Metadata": {
      "main": [
        [
          {
            "node": "Download Final Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Final Video": {
      "main": [
        [
          {
            "node": "Save Final Video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "pinData": {}
}
